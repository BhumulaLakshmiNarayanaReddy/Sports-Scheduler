<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= session.sport.name %> | Sports Scheduler
    </title>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/app-theme.css">

</head>

<body>

<div class="app-shell">

    <div class="mobile-topbar">

        <button
            class="mobile-menu-button"
            id="menuButton"
            type="button"
        >

            <span class="material-symbols-outlined">
                menu
            </span>

        </button>

        <div class="mobile-brand">

            <div class="brand-mark">

                <span class="material-symbols-outlined">
                    sports
                </span>

            </div>

            Sports Scheduler

        </div>

    </div>


    <div
        class="sidebar-overlay"
        id="sidebarOverlay"
    ></div>


    <aside
        class="app-sidebar"
        id="appSidebar"
    >

        <div class="sidebar-brand">

            <div class="brand-mark">

                <span class="material-symbols-outlined">
                    sports
                </span>

            </div>

            <span class="brand-text">
                Sports Scheduler
            </span>

        </div>


        <nav class="sidebar-navigation">

            <a href="/dashboard" class="sidebar-link">

                <span class="sidebar-link-icon material-symbols-outlined">
                    dashboard
                </span>

                <span class="sidebar-link-text">
                    Dashboard
                </span>

            </a>


            <a href="/sessions/create" class="sidebar-link">

                <span class="sidebar-link-icon material-symbols-outlined">
                    add_circle
                </span>

                <span class="sidebar-link-text">
                    Create Session
                </span>

            </a>


            <a href="/sessions/available" class="sidebar-link active">

                <span class="sidebar-link-icon material-symbols-outlined">
                    search
                </span>

                <span class="sidebar-link-text">
                    Available Sessions
                </span>

            </a>


            <a href="/sessions/my" class="sidebar-link">

                <span class="sidebar-link-icon material-symbols-outlined">
                    event
                </span>

                <span class="sidebar-link-text">
                    My Sessions
                </span>

            </a>


            <a href="/sessions/joined" class="sidebar-link">

                <span class="sidebar-link-icon material-symbols-outlined">
                    group
                </span>

                <span class="sidebar-link-text">
                    Joined Sessions
                </span>

            </a>


            <% if (typeof role !== "undefined" && role === "admin") { %>

                <div class="sidebar-divider"></div>

                <div class="sidebar-section-title">
                    Administration
                </div>

                <a href="/admin/sports" class="sidebar-link">

                    <span class="sidebar-link-icon material-symbols-outlined">
                        sports
                    </span>

                    <span class="sidebar-link-text">
                        Manage Sports
                    </span>

                </a>


                <a href="/admin/reports" class="sidebar-link">

                    <span class="sidebar-link-icon material-symbols-outlined">
                        analytics
                    </span>

                    <span class="sidebar-link-text">
                        Reports
                    </span>

                </a>

            <% } %>

        </nav>


        <div class="sidebar-footer">

            <a href="/logout" class="sidebar-link">

                <span class="sidebar-link-icon material-symbols-outlined">
                    logout
                </span>

                <span class="sidebar-link-text">
                    Sign Out
                </span>

            </a>

        </div>

    </aside>


    <main class="app-main">

        <div class="page-header">

            <div>

                <p class="page-eyebrow">
                    SESSION DETAILS
                </p>

                <h1>
                    <%= session.sport.name %>
                </h1>

                <p class="page-description">
                    View session information, players and availability.
                </p>

            </div>

        </div>


        <section class="session-hero">

            <div class="session-hero-icon">

                <span class="material-symbols-outlined">
                    sports
                </span>

            </div>


            <div class="session-hero-content">

                <span class="section-label">
                    SPORTS SESSION
                </span>

                <h2>
                    <%= session.sport.name %>
                </h2>

                <p>
                    Created by
                    <strong>
                        <%= session.createdBy.name %>
                    </strong>
                </p>

            </div>


            <div class="session-hero-actions">

                <% if (
                    session.status === "active" &&
                    new Date(session.dateTime) > new Date() &&
                    session.createdBy._id.toString() !== userId &&
                    session.joinedPlayers.length < session.additionalPlayersNeeded
                ) { %>

                    <form
                        action="/sessions/<%= session._id %>/join"
                        method="POST"
                    >

                        <button
                            type="submit"
                            class="primary-button"
                        >

                            <span class="material-symbols-outlined">
                                person_add
                            </span>

                            Join Session

                        </button>

                    </form>

                <% } %>

            </div>

        </section>


        <% if (session.status === "cancelled") { %>

            <section class="cancelled-banner">

                <div class="cancelled-icon">

                    <span class="material-symbols-outlined">
                        block
                    </span>

                </div>

                <div>

                    <span class="section-label">
                        SESSION STATUS
                    </span>

                    <h2>
                        Session Cancelled
                    </h2>

                    <p>

                        <strong>
                            Cancellation Reason:
                        </strong>

                        <%= session.cancellationReason %>

                    </p>

                </div>

            </section>

        <% } %>


        <div class="details-grid">

            <section class="details-card">

                <div class="card-heading">

                    <div class="action-icon blue">

                        <span class="material-symbols-outlined">
                            info
                        </span>

                    </div>

                    <div>

                        <h2>
                            Session Details
                        </h2>

                        <p>
                            Information about this session.
                        </p>

                    </div>

                </div>


                <div class="details-list">

                    <div class="detail-row">

                        <div class="detail-label">

                            <span class="material-symbols-outlined">
                                calendar_month
                            </span>

                            Date

                        </div>

                        <strong>
                            <%= new Date(session.dateTime).toLocaleDateString() %>
                        </strong>

                    </div>


                    <div class="detail-row">

                        <div class="detail-label">

                            <span class="material-symbols-outlined">
                                schedule
                            </span>

                            Time

                        </div>

                        <strong>
                            <%= new Date(session.dateTime).toLocaleTimeString([], {
                                hour: "2-digit",
                                minute: "2-digit"
                            }) %>
                        </strong>

                    </div>


                    <div class="detail-row">

                        <div class="detail-label">

                            <span class="material-symbols-outlined">
                                location_on
                            </span>

                            Venue

                        </div>

                        <strong>
                            <%= session.venue %>
                        </strong>

                    </div>


                    <div class="detail-row">

                        <div class="detail-label">

                            <span class="material-symbols-outlined">
                                person
                            </span>

                            Created By

                        </div>

                        <strong>
                            <%= session.createdBy.name %>
                        </strong>

                    </div>


                    <div class="detail-row">

                        <div class="detail-label">

                            <span class="material-symbols-outlined">
                                verified
                            </span>

                            Status

                        </div>

                        <span class="status-badge <%= session.status %>">
                            <%= session.status %>
                        </span>

                    </div>

                </div>

            </section>


            <section class="details-card">

                <div class="card-heading">

                    <div class="action-icon green">

                        <span class="material-symbols-outlined">
                            groups
                        </span>

                    </div>

                    <div>

                        <h2>
                            Participants
                        </h2>

                        <p>
                            <%= session.joinedPlayers.length %>
                            of
                            <%= session.additionalPlayersNeeded %>
                            additional players joined.
                        </p>

                    </div>

                </div>


                <div class="participant-list">

                    <div class="team-section">

                        <div class="team-heading">

                            <h3>
                                Team A
                            </h3>

                            <span>
                                <%= session.teamA.length %>
                                player(s)
                            </span>

                        </div>


                        <% if (session.teamA.length === 0) { %>

                            <p class="empty-text">
                                No players in Team A.
                            </p>

                        <% } else { %>

                            <% session.teamA.forEach(player => { %>

                                <div class="participant-row">

                                    <div class="participant-avatar">

                                        <span class="material-symbols-outlined">
                                            person
                                        </span>

                                    </div>

                                    <div>

                                        <strong>
                                            <%= player.name %>
                                        </strong>

                                    </div>

                                </div>

                            <% }) %>

                        <% } %>

                    </div>


                    <div class="team-section">

                        <div class="team-heading">

                            <h3>
                                Team B
                            </h3>

                            <span>
                                <%= session.teamB.length %>
                                player(s)
                            </span>

                        </div>


                        <% if (session.teamB.length === 0) { %>

                            <p class="empty-text">
                                No players in Team B.
                            </p>

                        <% } else { %>

                            <% session.teamB.forEach(player => { %>

                                <div class="participant-row">

                                    <div class="participant-avatar">

                                        <span class="material-symbols-outlined">
                                            person
                                        </span>

                                    </div>

                                    <div>

                                        <strong>
                                            <%= player.name %>
                                        </strong>

                                    </div>

                                </div>

                            <% }) %>

                        <% } %>

                    </div>

                </div>

            </section>

        </div>

    </main>

</div>


<script>

    const menuButton = document.getElementById("menuButton");
    const appSidebar = document.getElementById("appSidebar");
    const sidebarOverlay = document.getElementById("sidebarOverlay");

    menuButton.addEventListener("click", () => {

        appSidebar.classList.toggle("mobile-open");
        sidebarOverlay.classList.toggle("visible");

    });

    sidebarOverlay.addEventListener("click", () => {

        appSidebar.classList.remove("mobile-open");
        sidebarOverlay.classList.remove("visible");

    });

</script>

</body>

</html>